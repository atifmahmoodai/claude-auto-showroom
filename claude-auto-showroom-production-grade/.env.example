# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# docker-compose builds DATABASE_URL from POSTGRES_PASSWORD. Outside Docker set it yourself:
# DATABASE_URL=postgres://showroom:PASSWORD@localhost:5432/showroom

# --- Web ---
# The public address customers use (https in production). Used for the sitemap,
# email links and to reject cross-site requests.
PUBLIC_URL=http://localhost:8080
# Behind nginx / Caddy / a cloud load balancer that terminates https:
TRUST_PROXY=false
# Secure cookies require https. Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false
NODE_ENV=production
APP_PORT=8080

# Dealership time zone (IANA name) for "today": sale dates, test-drive dates.
TIMEZONE=America/New_York

# --- Sessions ---
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=12

# --- Email notifications for new website leads (optional) ---
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Apex Auto <no-reply@apexauto.example>
# LEAD_NOTIFY_EMAIL=sales@apexauto.example

# --- Uploads ---
UPLOAD_MAX_MB=8

LOG_LEVEL=info
RATE_LIMIT_PER_MIN=300
